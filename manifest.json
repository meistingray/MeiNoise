{
  "manifestVersion": 5,
  "id": "com.meistingray.meinoise",
  "name": "MeiNoise",
  "version": "0.1.5",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "meinoisePanel",
      "label": {
        "default": "MeiNoise"
      },
      "minimumSize": { "width": 260, "height": 460 },
      "preferredDockedSize": { "width": 300, "height": 560 },
      "preferredFloatingSize": { "width": 320, "height": 600 }
    }
  ]
}
